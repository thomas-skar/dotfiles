// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "show_background": true,
    "enabled": true
  },
  "always_treat_brackets_as_autoclosed": true,
  "toolbar": {
    "code_actions": true
  },
  "minimap": {
    "max_width_columns": 25,
    "show": "auto"
  },
  "show_signature_help_after_edits": false,
  "auto_signature_help": true,
  "smooth_scroll": {
    "enabled": true
  },
  "sticky_scroll": {
    "enabled": true
  },
  "autosave": "on_focus_change",
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "prettier": {
    "allowed": true
  },
  "close_on_file_delete": true,
  "search": {
    "include_ignored": false
  },
  "window_decorations": "server",
  "bottom_dock_layout": "full",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_from_file_finder": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true
  },
  "tabs": {
    "show_close_button": "always",
    "show_diagnostics": "errors",
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_menus": true,
    "show": true
  },
  "project_panel": {
    "button": true
  },
  "status_bar": {
    "icon_size": "large",
    "position": "bottom",
    "show": true
  },
  "text_rendering_mode": "subpixel",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "restore_on_startup": "last_session",
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "theme": "Zedokai Darker",
}
