{
  "lsp": {
    "nil": {},
    "nixd": {},
    "lemminx": {},
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 0,
    "active_line_width": 2,
    "background_coloring": "disabled",
    "coloring": "indent_aware",
  },
  "completion_menu_scrollbar": "auto",
  "languages": {
    "JSONC": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--write", "--parser", "jsonc", "--tab-width", "2"],
        },
      },
    },
    "Nix": {
      "language_servers": ["nixd", "nil"],
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": ["--quiet", "--"],
        },
      },
    },
    "XML": {
      "language_servers": ["lemminx"],
      "formatter": {
        "external": {
          "command": "xmlstarlet",
          "arguments": ["format", "--indent-spaces", "2", "-"],
        },
      },
    },
    "Lua": {
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--search-parent-directories",
            "--respect-ignores",
            "--stdin-filepath",
            "$FILENAME",
            "-",
          ],
        },
      },
    },
  },
  "vim_mode": true,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "show_background": true,
    "enabled": true,
  },
  "always_treat_brackets_as_autoclosed": true,
  "toolbar": {
    "code_actions": true,
  },
  "minimap": {
    "max_width_columns": 25,
    "show": "auto",
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "smooth_scroll": {
    "enabled": true,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "autosave": "on_focus_change",
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "prettier": {
    "allowed": true,
  },
  "close_on_file_delete": true,
  "search": {
    "include_ignored": false,
  },
  "window_decorations": "server",
  "bottom_dock_layout": "full",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": true,
    "enable_preview_multibuffer_from_code_navigation": true,
    "enable_preview_from_file_finder": true,
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true,
  },
  "tabs": {
    "show_close_button": "always",
    "show_diagnostics": "errors",
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "show_menus": true,
    "show": true,
  },
  "project_panel": {
    "button": true,
  },
  "status_bar": {
    "icon_size": "large",
    "position": "bottom",
    "show": true,
  },
  "text_rendering_mode": "platform_default",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "restore_on_startup": "last_session",
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "theme": "Zedokai Darker",
}
