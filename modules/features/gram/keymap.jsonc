[
  {
    "context": "Editor",
    "bindings": {
      "super-right": [
        "editor::MoveToEndOfLine",
        {
          "stop_at_soft_wraps": true
        }
      ],
      "super-left": [
        "editor::MoveToBeginningOfLine",
        {
          "stop_at_soft_wraps": true,
          "stop_at_indent": true
        }
      ],
      "super-up": "editor::MoveToBeginning",
      "super-down": "editor::MoveToEnd",
      "alt-left": "editor::MoveToPreviousWordStart",
      "alt-right": "editor::MoveToNextWordEnd",
      "ctrl-x": "editor::Cut",
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-a": "editor::SelectAll",
      "ctrl-w": "pane::CloseActiveItem"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-s": "workspace::SaveAll",
      "ctrl-v": "vim::Paste",
      "ctrl-l": "vim::SwitchToVisualLineMode",
      "ctrl-c": "vim::YankLine",
      "space space": "vim::SwitchToInsertMode",
      "space s r": "pane::SplitRight",
      "space k c": "vim::ToggleComments",
      "tab": "vim::Indent",
      "shift-tab": "vim::Outdent",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-v": "vim::Paste",
      "super-backspace": "editor::DeleteToBeginningOfLine",
      "super-delete": "vim::DeleteToEndOfLine",
      "alt-backspace": "editor::DeleteToPreviousSubwordStart",
      "alt-delete": "editor::DeleteToNextSubwordEnd"
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "l": "vim::SwitchToVisualLineMode",
      "c": "vim::VisualYank",
      "i": "vim::SwitchToInsertMode",
      "shift-left": "editor::SelectToPreviousSubwordStart",
      "shift-right": "editor::SelectToNextSubwordEnd",
      "super-left": "editor::SelectToBeginningOfLine",
      "shift-super-left": "editor::SelectToBeginningOfLine",
      "super-right": "editor::SelectToEndOfLine",
      "shift-super-right": "editor::SelectToEndOfLine",
      "alt-left": "editor::SelectToPreviousWordStart",
      "shift-alt-left": "editor::SelectToPreviousWordStart",
      "alt-right": "editor::SelectToNextWordEnd",
      "shift-alt-right": "editor::SelectToNextWordEnd",
    },
  },
]
