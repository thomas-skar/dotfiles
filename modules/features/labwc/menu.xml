<?xml version="1.0" encoding="UTF-8" ?>
<openbox_menu>
  <menu id="root-menu">
    <item label="Ghostty (Copilot+G)">
      <action name="Execute" command="ghostty" />
    </item>
    <item label="Foot">
      <action name="Execute" command="foot" />
    </item>
    <separator />
    <item label="Reconfigure (CapsLock+R)">
      <action name="Reconfigure" />
    </item>
    <item label="Exit">
      <action name="Exit" />
    </item>
  </menu>
  <menu id="client-menu">
    <item label="Minimize">
      <action name="Iconify" />
    </item>
    <item label="Maximize (CapsLock+Enter)">
      <action name="Maximize" direction="both" />
    </item>
    <separator />
    <item label="Omnipresent">
      <action name="ToggleOmnipresent" />
    </item>
    <item label="Decorations">
      <action name="ToggleDecorations" />
    </item>
    <separator />
    <item label="Close (Meta+Q)">
      <action name="Close" />
    </item>
  </menu>
</openbox_menu>
