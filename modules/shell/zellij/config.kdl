// TODO: show "move tab" keybinds (Clt+I/O) in status bar!
// TODO: zjstatus!
on_focus_close "quit"
simplified_ui false
default_shell "fish"
pane_frames true
theme "ansi"
default_layout "default"
default_mode "normal"
mouse_mode true
copy_clipboard "system"
copy_on_select true
// scrollback_editor $EDITOR
env {}
ui {
  pane_frames {
    rounded_corners true
    hide_session_name true
  }
}
auto_layout true
styled_underlines true
session_serialization true
pane_viewport_serialization true
show_startup_tips false
show_release_notes false
web_server false
advanced_mouse_actions true
default_cwd "/home/thomas"
osc8_hyperlinks true
session_name "default"
attach_to_session true
mouse_hover_effects true
visual_bell true
focus_follows_mouse true
mouse_click_through false
pane_frame_style "full"
stacked_pane_list true
mouse_scroll_resize true
mouse_hover_tips true
osc133_command_selection true

keybinds {
	normal {
		bind "Ctrl Shift t" {
			NewTab
			SwitchToMode "Normal"
		}
		bind "Ctrl Shift w" {
			CloseTab
			SwitchToMode "Normal"
		}
		bind "Alt 1" {
			GoToTab 1
			SwitchToMode "Normal"
		}
		bind "Alt 2" {
			GoToTab 2
			SwitchToMode "Normal"
		}
		bind "Alt 3" {
			GoToTab 3
			SwitchToMode "Normal"
		}
		bind "Alt 4" {
			GoToTab 4
			SwitchToMode "Normal"
		}
		bind "Alt 5" {
			GoToTab 5
			SwitchToMode "Normal"
		}
		bind "Alt 6" {
			GoToTab 6
			SwitchToMode "Normal"
		}
		bind "Alt 7" {
			GoToTab 7
			SwitchToMode "Normal"
		}
		bind "Alt 8" {
			GoToTab 8
			SwitchToMode "Normal"
		}
		bind "Alt 9" {
			GoToTab 9
			SwitchToMode "Normal"
		}
	}
}
