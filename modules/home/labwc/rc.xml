<?xml version="1.0" encoding="UTF-8" ?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>10</gap>
  </core>
  <placement>
    <policy>cascade</policy>
  </placement>
  <windowSwitcher outlines="yes" preview="yes" unshade="yes">
    <osd style="classic" output="all" />
    <fields>
      <field content="icon" width="5%" />
      <field content="desktop_entry_name" width="25%" />
      <field content="title" width="60%" />
      <field content="output" width="10%" />
    </fields>
  </windowSwitcher>
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <snapping>
    <overlay>
      <enabled>yes</enabled>
    </overlay>
  </snapping>
  <theme>
    <name>nix</name>
    <icon>MacTahoe</icon>
    <dropShadows>yes</dropShadows>
    <keepBorder>yes</keepBorder>
  </theme>
  <keyboard>
    <!-- Next window (Alt+Tab) -->
    <keybind key="A-Tab">
      <action name="NextWindow" workspace="all" output="all" identifier="all" />
    </keybind>
    <!-- Close window (Super+Q) -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <!-- Show labwc client menu (Alt+Space) -->
    <keybind key="A-Space">
      <action name="ShowMenu" menu="client-menu" atCursor="no" />
    </keybind>
    <!-- Show desktop (CapsLock+D) -->
    <keybind key="S-C-A-W-M-d">
      <action name="ToggleShowDesktop" />
    </keybind>
    <!-- Reload labwc config (CapsLock+R) -->
    <keybind key="S-C-A-W-M-r">
      <action name="Reconfigure" />
    </keybind>
    <!-- Maximize window (CapsLock+Return) -->
    <keybind key="S-C-A-W-M-Return">
      <action name="SnapToEdge" direction="center" />
    </keybind>
    <!-- Center window (CapsLock+C) -->
    <keybind key="S-C-A-W-M-c">
      <action name="AutoPlace" policy="center" />
    </keybind>
    <!-- Resize window left (CapsLock+Left) -->
    <keybind key="S-C-A-W-M-Left">
      <action name="SnapToEdge" direction="left" combine="yes" />
    </keybind>
    <!-- Resize window right (CapsLock+Right) -->
    <keybind key="S-C-A-W-M-Right">
      <action name="SnapToEdge" direction="right" combine="yes" />
    </keybind>
    <!-- Resize window up (CapsLock+Up) -->
    <keybind key="S-C-A-W-M-Up">
      <action name="SnapToEdge" direction="up" combine="yes" />
    </keybind>
    <!-- Resize window down (CapsLock+Down) -->
    <keybind key="S-C-A-W-M-Down">
      <action name="SnapToEdge" direction="down" combine="yes" />
    </keybind>
    <!-- Move window to next output (CapsLock+N): eDP-1 >>> DVI-I-2 >>> DVI-I-1 >>> eDP-1 -->
    <keybind key="S-C-A-W-M-n">
      <action name="If">
        <query monitor="eDP-1" />
        <then>
          <action name="MoveToOutput" output="DVI-I-1" />
        </then>
        <else>
          <action name="If">
            <query monitor="DVI-I-1" />
            <then>
              <action name="MoveToOutput" output="DVI-I-2" />
            </then>
            <else>
              <action name="MoveToOutput" output="eDP-1" />
            </else>
          </action>
        </else>
      </action>
    </keybind>
    <!-- Grow window (CapsLock+Plus) -->
    <keybind key="S-C-A-W-M-+">
      <action name="ResizeRelative" left="25" right="25" top="25" bottom="25" />
    </keybind>
    <!-- Shrink window (CapsLock+Minus) -->
    <keybind key="S-C-A-W-M--">
      <action
        name="ResizeRelative"
        left="-25"
        right="-25"
        top="-25"
        bottom="-25"
      />
    </keybind>
    <!-- Set preset window size 1 and center window (CapsLock+V) -->
    <keybind key="S-C-A-W-M-v">
      <action name="If">
        <query monitor="eDP-1" />
        <then>
          <action name="ResizeTo" width="1280" height="800" />
        </then>
        <else>
          <action name="ResizeTo" width="1920" height="1200" />
        </else>
      </action>
      <action name="AutoPlace" policy="center" />
    </keybind>
    <!-- Set preset window size 2 and center window (CapsLock+B) -->
    <keybind key="S-C-A-W-M-b">
      <action name="If">
        <query monitor="eDP-1" />
        <then>
          <action name="ResizeTo" width="1440" height="900" />
        </then>
        <else>
          <action name="ResizeTo" width="2240" height="1320" />
        </else>
      </action>
      <action name="AutoPlace" policy="center" />
    </keybind>
    <!-- Set preset window size 3 and center window (CapsLock+X) -->
    <keybind key="S-C-A-W-M-x">
      <action name="If">
        <query monitor="eDP-1" />
        <then>
          <action name="ResizeTo" width="576" height="1080" />
        </then>
        <else>
          <action name="ResizeTo" width="768" height="1296" />
        </else>
      </action>
      <action name="AutoPlace" policy="center" />
    </keybind>

    <!-- Next window of same type (CapsLock+K) -->
    <keybind key="S-C-A-W-M-k">
      <action
        name="NextWindow"
        workspace="all"
        output="all"
        identifier="current"
      />
    </keybind>
    <!-- Previous window of same type (CapsLock+L) -->
    <keybind key="S-C-A-W-M-j">
      <action
        name="PreviousWindow"
        workspace="all"
        output="all"
        identifier="current"
      />
    </keybind>

    <!-- Run or raise ghostty/ goland (Copilot+G) -->
    <keybind key="S-C-A-W-g">
      <action name="ForEach">
        <query identifier="com.mitchellh.ghostty" />
        <then>
          <action name="ForEach">
            <query identifier="com.mitchellh.ghostty" focused="no" />
            <then>
              <action name="Raise" />
              <action name="Focus" />
            </then>
            <none>
              <action name="ForEach">
                <query identifier="jetbrains-goland" focused="no" />
                <then>
                  <action name="Raise" />
                  <action name="Focus" />
                </then>
              </action>
            </none>
          </action>
        </then>
        <none>
          <action name="Execute" command="ghostty" />
        </none>
      </action>
    </keybind>
    <!-- Run or raise microsoft edge (Copilot+E) -->
    <keybind key="S-C-A-W-e">
      <action name="ForEach">
        <query identifier="microsoft-edge" />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
          <action name="Execute" command="microsoft-edge" />
        </none>
      </action>
    </keybind>
    <!-- Run or raise zed (Copilot+Z) -->
    <keybind key="S-C-A-W-z">
      <action name="ForEach">
        <query identifier="dev.zed.Zed" />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
          <action name="Execute" command="zeditor" />
        </none>
      </action>
    </keybind>
    <!-- Run or raise files app (Copilot+F) -->
    <keybind key="S-C-A-W-f">
      <action name="ForEach">
        <query identifier="org.gnome.Nautilus" />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
          <action name="Execute" command="nautilus" />
        </none>
      </action>
    </keybind>
    <!-- Run or raise slack/ spotify (Copilot+S) -->
    <keybind key="S-C-A-W-s">
      <action name="ForEach">
        <query identifier="slack" />
        <then>
          <action name="ForEach">
            <query identifier="slack" focused="no" />
            <then>
              <action name="Raise" />
              <action name="Focus" />
            </then>
            <none>
              <action name="ForEach">
                <query identifier="spotify" focused="no" />
                <then>
                  <action name="Raise" />
                  <action name="Focus" />
                </then>
              </action>
            </none>
          </action>
        </then>
        <none>
          <action name="Execute" command="slack" />
        </none>
      </action>
    </keybind>
    <!-- Run or raise pycharm/ protonmail (Copilot+P) -->
    <keybind key="S-C-A-W-p">
      <action name="ForEach">
        <action name="ForEach">
          <query identifier="proton-mail" focused="no" />
          <then>
            <action name="Raise" />
            <action name="Focus" />
          </then>
        </action>
        <none>
          <action name="ForEach">
            <query identifier="jetbrains-pycharm" focused="no" />
            <then>
              <action name="Raise" />
              <action name="Focus" />
            </then>
          </action>
        </none>
      </action>
    </keybind>
    <!-- Run or raise teams-for-linux/PWA (Copilot+T) -->
    <keybind key="S-C-A-W-t">
      <action name="ForEach">
        <query identifier="teams-for-linux" focused="no" />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
          <action name="ForEach">
            <query
              identifier="msedge-_ompifgpmddkgmclendfeacglnodjjndh-Default"
              focused="no"
            />
            <then>
              <action name="Raise" />
              <action name="Focus" />
            </then>
            <none>
              <action
                name="Execute"
                command="gio launch /home/thomas/.local/share/applications/msedge-_ompifgpmddkgmclendfeacglnodjjndh-Default.desktop"
              />
            </none>
          </action>
        </none>
      </action>
    </keybind>
    <!-- Run or raise (cursed) outlook PWA/ obsidian (Copilot+O) -->
    <keybind key="S-C-A-W-o">
      <action name="ForEach">
        <query
          identifier="msedge-_eoficlgicibekocmfdomjbfnjmehnhcd-Default"
          focused="no"
        />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
          <action name="ForEach">
            <query identifier="md.Obsidian" focused="no" />
            <then>
              <action name="Raise" />
              <action name="Focus" />
            </then>
            <none>
              <action
                name="Execute"
                command="gio launch /home/thomas/.local/share/applications/msedge-eoficlgicibekocmfdomjbfnjmehnhcd-Default.desktop"
              />
            </none>
          </action>
        </none>
      </action>
    </keybind>
    <!-- Run or raise 1password (Copilot+1) -->
    <keybind key="S-C-A-W-1">
      <action name="ForEach">
        <query identifier="1password" />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
          <action name="Execute" command="1password" />
        </none>
      </action>
    </keybind>

    <!-- Noctalia: open launcher (Super+Space) -->
    <keybind key="W-Space">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <!-- Noctalia: lock session (CapsLock+L) -->
    <keybind key="S-C-A-W-M-l">
      <action name="Execute" command="noctalia msg session lock" />
    </keybind>
    <!-- Noctalia: show session menu (CapsLock+P) -->
    <keybind key="S-C-A-W-M-p">
      <action name="Execute" command="noctalia msg panel-toggle session" />
    </keybind>
    <!-- Noctalia: show clipboard manager (CapsLock+M) -->
    <keybind key="S-C-A-W-M-m">
      <action name="Execute" command="noctalia msg panel-toggle clipboard" />
    </keybind>
    <!-- Noctalia: screenshot (PrtSc) -->
    <keybind key="Print">
      <action name="Execute" command="noctalia msg screenshot-region" />
    </keybind>

    <!-- Noctalia: hardware controls -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="noctalia msg volume-up" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="noctalia msg volume-down" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="noctalia msg volume-mute" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="noctalia msg brightness-up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="noctalia msg brightness-down" />
    </keybind>
  </keyboard>
  <mouse>
    <!-- TODO: replace -->
    <default />
  </mouse>
  <libinput>
    <device>
      <accelProfile>adaptive</accelProfile>
      <naturalScroll>yes</naturalScroll>
      <pointerSpeed>1.0</pointerSpeed>
      <scrollMethod>twofinger</scrollMethod>
      <tap>yes</tap>
      <tapAndDrag>no</tapAndDrag>
      <threeFingerDrag>no</threeFingerDrag>
    </device>
  </libinput>
  <windowRules>
    <!-- Teams: move to eDP-1 -->
    <windowRule identifier="teams-for-linux">
      <action name="MoveToOutput" output="eDP-1" />
    </windowRule>
    <!-- Slack: move to eDP-1 -->
    <windowRule identifier="slack">
      <action name="MoveToOutput" output="eDP-1" />
    </windowRule>
    <!-- Spotify: move to eDP-1 -->
    <windowRule identifier="spotify">
      <action name="MoveToOutput" output="eDP-1" />
    </windowRule>
    <!-- Outlook PWA: move to eDP-1 -->
    <windowRule identifier="msedge-_eoficlgicibekocmfdomjbfnjmehnhcd-Default">
      <action name="MoveToOutput" output="eDP-1" />
    </windowRule>

    <!-- Ghostty: move to DVI-I-1 -->
    <windowRule identifier="com.mitchellh.ghostty">
      <action name="MoveToOutput" output="DVI-I-1" />
    </windowRule>
    <!-- Zed: move to DVI-I-1 -->
    <windowRule identifier="dev.zed.Zed">
      <action name="MoveToOutput" output="DVI-I-1" />
    </windowRule>

    <!-- Gnome keychain prompt: float window  -->
    <windowRule identifier="gcr-prompter">
      <action name="ToggleAlwaysOnTop" />
    </windowRule>
    <!-- Microsoft login prompt: float window -->
    <windowRule identifier="microsoft-identity-broker">
      <action name="ToggleAlwaysOnTop" />
    </windowRule>

  </windowRules>
</labwc_config>
