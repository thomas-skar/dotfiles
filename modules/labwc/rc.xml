<?xml version="1.0" encoding="UTF-8" ?>
<labwc_config>
  <core>
    <decoration>client</decoration>
    <gap>10</gap>
  </core>
  <placement>
      <policy>cascade</policy>
  </placement>
  <windowSwitcher outlines="yes" preview="yes" unshade="yes">
      <osd style="classic" output="all" />
  </windowSwitcher>
  <focus>
      <followMouse>no</followMouse>
      <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <snapping>
      <overlay>
          <enabled>yes</enabled>
      </overlay>
  </snapping>
  <theme>
    <name>Adwaita</name>
    <icon>MacTahoe</icon>
    <dropShadows>yes</dropShadows>
  </theme>
  <keyboard>
    <!-- Labwc: next window (Alt+Tab) -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <!-- Labwc: previous window (Alt+Shift+Tab) -->
    <keybind key="A-S-Tab">
      <action name="NextWindow" />
    </keybind>
    <!-- Labwc: close window (Super+Q) -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <!-- Labwc: show client menu (Alt+Space) -->
    <keybind key="A-Space">
      <action name="ShowMenu" menu="client-menu" atCursor="no" />
    </keybind>
    <!-- Labwc: show desktop (CapsLock+D) -->
    <keybind key="S-C-A-W-M-d">
      <action name="ToggleShowDesktop" />
    </keybind>
    <!-- Labwc: reload config (CapsLock+R) -->
    <keybind key="S-C-A-W-M-r">
      <action name="Reconfigure" />
    </keybind>
    <!-- Labwc: maximize window (CapsLock+Return) -->
    <keybind key="S-C-A-W-M-Return">
      <action name="ToggleMaximize" direction="both" />
    </keybind>
    <!-- Labwc: center window (CapsLock+C) -->
    <keybind key="S-C-A-W-M-c">
      <action name="AutoPlace" policy="center" />
    </keybind>
    <!-- Labwc: resize window left (CapsLock+Left) -->
    <keybind key="S-C-A-W-M-Left">
      <action name="SnapToEdge" direction="left" combine="yes" />
    </keybind>
    <!-- Labwc: resize window right (CapsLock+Right) -->
    <keybind key="S-C-A-W-M-Right">
      <action name="SnapToEdge" direction="right" combine="yes" />
    </keybind>
    <!-- Labwc: resize window up (CapsLock+Up) -->
    <keybind key="S-C-A-W-M-Up">
      <action name="SnapToEdge" direction="up" combine="yes" />
    </keybind>
    <!-- Labwc: resize window down (CapsLock+Down) -->
    <keybind key="S-C-A-W-M-Down">
      <action name="SnapToEdge" direction="down" combine="yes" />
    </keybind>
    <!-- Labwc: move window to next output (CapsLock+N) -->
    <keybind key="S-C-A-W-M-n">
      <action name="MoveToOutput" direction="right" wrap="yes" />
    </keybind>
    <!-- Labwc: grow window  (CapsLock+Plus) -->
    <keybind key="S-C-A-W-M-+">
      <action name="ResizeRelative" left="20" right="20" top="20" bottom="20" />
    </keybind>
    <!-- Labwc: shrink window  (CapsLock+Plus) -->
    <keybind key="S-C-A-W-M--">
      <action
        name="ResizeRelative"
        left="-20"
        right="-20"
        top="-20"
        bottom="-20"
      />
    </keybind>
    <!-- Labwc: focus ghostty/ goland (Copilot+G) -->
    <keybind key="S-C-A-W-g">
      <action name="ForEach">
        <query identifier="com.mitchellh.ghostty" focused="no" />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
          <action name="ForEach">
            <query identifier="jetbrains-goland" focused="no" />
            <then>
              <action name="Raise" />
              <action name="Focus" />
            </then>
          </action>
        </none>
      </action>
    </keybind>
    <!-- Labwc: focus edge (Copilot+E) -->
    <!-- TODO: focus switch only works w/ 2 windows :( -->
    <keybind key="S-C-A-W-e">
      <action name="ForEach">
        <query identifier="microsoft-edge" focused="no" />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
          <action name="ForEach">
            <query identifier="microsoft-edge" />
            <none>
                <action name="Execute" command="microsoft-edge" />
            </none>
          </action>
        </none>
      </action>
    </keybind>
    <!-- Labwc: focus zed (Copilot+Z) -->
    <keybind key="S-C-A-W-z">
      <action name="ForEach">
        <query identifier="dev.zed.Zed" />
        <then>
          <action name="Raise" />
          <action name="Focus" />
        </then>
        <none>
            <action name="Execute" command="zeditor" />
        </none>
      </action>
    </keybind>
    <!-- Labwc: focus/ open files app (Copilot+F) -->
    <keybind key="S-C-A-W-f">
      <action name="ForEach">
        <query identifier="org.gnome.Nautilus" />
        <then>
            <action name="Raise" />
            <action name="Focus" />
        </then>
        <none>
            <action name="Execute" command="nautilus" />
        </none>
      </action>
    </keybind>
    <!-- Labwc: focus slack (Copilot+S) -->
    <keybind key="S-C-A-W-s">
      <action name="ForEach">
        <query identifier="slack" />
        <then>
            <action name="Raise" />
            <action name="Focus" />
        </then>
        <none>
            <action name="Execute" command="slack" />
        </none>
      </action>
    </keybind>

    <!-- Noctalia: open launcher (Super+Space) -->
    <keybind key="W-Space">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <!-- Noctalia: hardware controls -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="noctalia msg volume-up" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="noctalia msg volume-down" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="noctalia msg volume-mute" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="noctalia msg brightness-up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="noctalia msg brightness-down" />
    </keybind>
  </keyboard>
  <libinput>
    <device>
      <accelProfile>adaptive</accelProfile>
      <naturalScroll>yes</naturalScroll>
      <pointerSpeed>1.0</pointerSpeed>
      <scrollMethod>twofinger</scrollMethod>
      <tap>yes</tap>
      <tapAndDrag>no</tapAndDrag>
      <threeFingerDrag>no</threeFingerDrag>
    </device>
  </libinput>
</labwc_config>
